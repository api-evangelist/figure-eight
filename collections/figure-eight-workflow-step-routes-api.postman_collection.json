        {
          "id": "4f21bd96-8c60-474a-9291-891ea23299cc",
          "name": "Create a new workflow route",
          "request": {
            "name": "Create a new workflow route",
            "description": {
              "content": "Create a configuration object for routing data coming out of the data processor in the step specified by `workflow_step_id` to the step specified by `destination_step_id`.\nThink of `workflow_step` and `destination_step` as _nodes_ in the Workflow's configuration 'graph' and this route as the _edge_ between them.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "workflows",
                ":workflow_id",
                "steps",
                ":step_id",
                "routes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "workflow_id",
                  "description": "(Required) The `id` of a **Workflow** belonging to the **Requestor** or accessible to the **Admin**."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "step_id",
                  "description": "(Required) Workflow Step database ID"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination_step_id\": \"<integer>\",\n  \"filter_rules_attributes\": [\n    {\n      \"comparison_field\": \"<string>\",\n      \"comparison_value\": \"<string>\",\n      \"comparison_operation\": \"<string>\",\n      \"rule_connector\": \"<string>\"\n    },\n    {\n      \"comparison_field\": \"<string>\",\n      \"comparison_value\": \"<string>\",\n      \"comparison_operation\": \"<string>\",\n      \"rule_connector\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "6b254056-d709-4981-9da7-234a8bc7fd28",
              "name": "Route created",
              "originalRequest": {
                "url": {
                  "path": [
                    "workflows",
                    ":workflow_id",
                    "steps",
                    ":step_id",
                    "routes"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<integer>",
                      "key": "workflow_id",
                      "description": "(Required) The `id` of a **Workflow** belonging to the **Requestor** or accessible to the **Admin**."
                    },
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<integer>",
                      "key": "step_id",
                      "description": "(Required) Workflow Step database ID"
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"destination_step_id\": 19,\n  \"filter_rules_attributes\": [\n    {\n      \"comparison_field\": \"img_is_cat\",\n      \"comparison_value\": \"true\",\n      \"comparison_operation\": \"==\",\n      \"rule_connector\": \"and\"\n    },\n    {\n      \"comparison_field\": \"img_is_cat\",\n      \"comparison_value\": \"true\",\n      \"comparison_operation\": \"==\",\n      \"rule_connector\": \"and\"\n    }\n  ]\n}",
